<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الموقع: FINE لازم للملاحة، وCOARSE احتياط حين يرفض المستخدم
         الدقيق — الخريطة تشتغل به وإن كان السهم أقل دقة -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- الموقع في الخلفية: الملاحة لازم تكمل والشاشة مقفلة أو التطبيق
         مصغّر. أندرويد 10+ يفصلها عن صلاحية الموقع العادية، وأندرويد
         11+ ما يعطيها إلا من شاشة الإعدادات -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- خدمة مقدّمة بنوع location: أندرويد 14+ يفرض إعلان النوع في
         الـmanifest وإلا رفض تشغيل الخدمة بـSecurityException -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- الإشعار الدائم للخدمة المقدّمة. أندرويد 13+ يطلبه صلاحيةً -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- إعفاء من تحسين البطارية. ما نطلبه تلقائياً — نشرحه للمستخدم
         أولاً. بلاه تقتل Xiaomi و Huawei خدمة الملاحة بعد دقائق -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- التطبيق ملاحة سيارة: الجهاز بلا GPS ما ينفع، فنمنع تنصيبه
         عليه بدل ما يُنصَّب ويفشل بلا سبب واضح -->
    <uses-feature android:name="android.hardware.location.gps"
        android:required="true"/>

    <!-- networkSecurityConfig: البلاطات تُقدَّم من سيرفر HTTP محلي على
         127.0.0.1، وأندرويد 9+ يمنع HTTP بلا تشفير افتراضياً. الإعداد
         يسمح بالمحلي فقط — انظر res/xml/network_security_config.xml -->
    <application
        android:label="درب"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- screenOrientation=fullSensor: السائق يثبّت الجهاز بأي اتجاه،
             وقفل الاتجاه يخرّب نصف التثبيتات -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="fullSensor">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- فتح إحداثيات من تطبيق آخر (واتساب، متصفح، مشاركة موقع):
                 هكذا يصير darb بديلاً فعلياً لا تطبيقاً منفصلاً يُنسخ له
                 الموقع يدوياً -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="geo"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
